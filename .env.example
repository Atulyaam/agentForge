MAX_INPUT_CHARS=20000
MAX_CONTEXT_CHARS=30000
MAX_OUTPUT_BYTES=1000000
LOG_MAX_BYTES=200000
MAX_LLM_CALLS_PER_RUN=
CACHE_ENABLED=false
